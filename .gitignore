# ארטיפקטים של Dart/Flutter — נוצרים מ-`pub get`/`build` בכל אחת מחמש
# החבילות שברפו, ולכן מוגדרים כאן פעם אחת ולא בכל תיקייה בנפרד.
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies

# ה-CI מריץ `pub get` טרי בכל ג'וב, ואין ברפו הזה אף pubspec.lock מנוהל —
# שומרים על אותה מדיניות.
pubspec.lock

# רשומות התוספים נוצרות מחדש בכל `pub get`, ולכן מייצרות רק רעש בדיפים.
**/flutter/ephemeral/
**/Flutter/ephemeral/
**/flutter/generated_plugin_registrant.cc
**/flutter/generated_plugin_registrant.h
**/flutter/generated_plugins.cmake
**/Flutter/GeneratedPluginRegistrant.swift
**/GeneratedPluginRegistrant.java
**/GeneratedPluginRegistrant.m
**/GeneratedPluginRegistrant.h

# פלט Visual Studio / MSBuild מהרצה מקומית של `flutter run -d windows`
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj.filters
.vs/

# macOS / IDE
.DS_Store
.idea/
*.iml
*.log

# מטמון מקומי של sentry-native — נוצר בכל הרצה של הלאנצ'ר בווינדוס
# (מזהה התקנה, breadcrumbs, session). לא קוד ולא הגדרה.
.sentry-native/
