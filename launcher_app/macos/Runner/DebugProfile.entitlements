<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- כבוי מאותן סיבות שב-Release.entitlements (ראו ההסבר המלא שם).
	     חייב להיות זהה, אחרת הרצה ב-debug מתנהגת אחרת מהגרסה המופצת. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- שני אלה נדרשים ל-debug בלבד: JIT ל-Dart VM, ו-server כדי
	     ש-DevTools/hot-reload יוכלו להתחבר. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
