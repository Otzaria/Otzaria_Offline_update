#pragma code_page(65001)
#include <winres.h>

// אותו אייקון של הלאנצ'ר האמיתי — למשתמש זו אותה תוכנה.
1 ICON "..\\windows\\runner\\resources\\app_icon.ico"

// RT_MANIFEST(24) תחת המזהה 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID.
1 24 "stub.exe.manifest"

// ערמת הקבצים עצמה, מוטמעת ב-exe. package.ps1 מייצר את ה-zip לפני הקימפול;
// המזהה חייב להתאים ל-PAYLOAD_RESOURCE_ID שב-stub.c.
100 RCDATA "build\\payload.zip"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "org.otzaria" "\0"
            VALUE "FileDescription", "עדכוני אוצריא" "\0"
            VALUE "FileVersion", "1.0.0" "\0"
            VALUE "InternalName", "launcher_stub" "\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 org.otzaria. All rights reserved." "\0"
            VALUE "OriginalFilename", "עדכוני אוצריא.exe" "\0"
            VALUE "ProductName", "עדכוני אוצריא" "\0"
            VALUE "ProductVersion", "1.0.0" "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
